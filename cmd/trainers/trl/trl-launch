# The Torch plugin publishes the cluster topology as PET_*, which is torchrun's
# own env interface. `trl` hands off to accelerate, which is a peer of torchrun,
# not a layer beneath it: it has no knowledge of PET_* and reads topology from
# flags only. Translate, guard, exec. No training logic lives here.
#
# The guards are not defensive padding. Every configuration they reject exits 0
# under accelerate, so without them a misconfigured job trains N isolated copies
# and reports success. See proposals/2839-dynamic-llm-trainer/README.md, I.3.
#
# Set TRL_SKIP_ACCELERATE_ARGS=1 to skip the translation and run bare.

set -eu

METHOD="${TRL_METHOD:-sft}"

if [ "${TRL_SKIP_ACCELERATE_ARGS:-0}" = "1" ]; then
    echo "[trl-launch] trl ${METHOD} $*"
    exec trl "${METHOD}" "$@"
fi

NNODES="${PET_NNODES:-1}"
NODE_RANK="${PET_NODE_RANK:-0}"
NPROC="${PET_NPROC_PER_NODE:-1}"

# The plugin sets "auto" when GPUs are requested; accelerate needs a number.
# "auto" means one process per GPU, so resolving it to 1 with no GPU visible
# would silently turn a distributed request into a single-process run.
if [ "${NPROC}" = "auto" ]; then
    PY=$(command -v python || command -v python3)
    if ! NPROC=$("${PY}" -c 'import torch; print(torch.cuda.device_count())'); then
        echo "[trl-launch] ERROR: could not query the CUDA device count." >&2
        exit 1
    fi
    if [ "${NPROC}" = "0" ]; then
        echo "[trl-launch] ERROR: PET_NPROC_PER_NODE=auto but no CUDA device is visible." >&2
        echo "[trl-launch] Set numProcPerNode explicitly, or request a GPU." >&2
        exit 1
    fi
fi

TOTAL=$((NPROC * NNODES))

# accelerate's distributed branches in launch_command are each guarded
# "and not args.cpu", so a CPU run falls through to simple_launcher, which
# spawns one subprocess and never sets RANK/WORLD_SIZE. Multi-process CPU
# needs --mpirun_hostfile, which PET_* cannot supply.
for arg in "$@"; do
    case "${arg}" in
        --use_cpu | --use_cpu=* | --cpu | --cpu=*)
            if [ "${TOTAL}" -gt 1 ]; then
                echo "[trl-launch] ERROR: ${TOTAL} processes requested with --use_cpu." >&2
                echo "[trl-launch] accelerate cannot run multi-process on CPU without MPI." >&2
                echo "[trl-launch] Request a GPU, or set numNodes and numProcPerNode to 1." >&2
                exit 1
            fi
            ;;
    esac
done

# --num_processes is the total across machines, not per node.
set -- \
    --num_processes "${TOTAL}" \
    --num_machines "${NNODES}" \
    --machine_rank "${NODE_RANK}" \
    --main_process_ip "${PET_MASTER_ADDR:-localhost}" \
    --main_process_port "${PET_MASTER_PORT:-29500}" \
    "$@"

# accelerate infers --multi_gpu only from the *local* device count, which is 1
# in the standard one-GPU-per-pod layout. Without this the run degrades to
# world_size 1 on every pod and still exits 0.
if [ "${TOTAL}" -gt 1 ]; then
    set -- --multi_gpu "$@"
fi

echo "[trl-launch] trl ${METHOD} $*"
exec trl "${METHOD}" "$@"
